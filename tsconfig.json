{
  "compilerOptions": {
    "target": "ES2017",
    "module": "none",
    "lib": [
      "DOM",
      "ES2017"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "newLine": "lf",
    "strict": true,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
